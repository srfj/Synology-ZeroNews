#!/bin/sh
# ZeroNews 群晖套件 - 服务启停控制脚本
#
# DSM 6.x 使用 systemd 以外的机制管理套件进程，因此这里直接以常驻前台进程方式
# 启动 zeronews 客户端，并自行维护 pid 文件，而不是调用 `zeronews service install`
# （后者依赖 systemd，DSM 6.2.3 上不可用）。

PKG_NAME="zeronews"
PKG_DIR="/var/packages/${PKG_NAME}/target"
VAR_DIR="/var/packages/${PKG_NAME}/var"
PKG_SCRIPTS="/var/packages/${PKG_NAME}/scripts"
BIN="${PKG_DIR}/bin/zeronews"
PIDFILE="${VAR_DIR}/zeronews.pid"
LOGFILE="${VAR_DIR}/logs/service.log"
UIPIDFILE="${VAR_DIR}/ui_publisher.pid"
PENDING_TOKEN="${VAR_DIR}/authtoken.pending"

is_running() {
    [ -f "${PIDFILE}" ] || return 1
    _pid=$(cat "${PIDFILE}" 2>/dev/null)
    [ -n "${_pid}" ] || return 1
    kill -0 "${_pid}" 2>/dev/null
}

is_configured() {
    [ -f "${BIN}" ] || return 1
    "${BIN}" --workdir "${VAR_DIR}" status --json 2>/dev/null \
        | grep -qE '"configured"[[:space:]]*:[[:space:]]*true'
}

# 安装阶段若因网络/DNS 未就绪导致 Token 认证失败，postinst 会把 Token 暂存在
# authtoken.pending；这里在每次启动前重试，绑定成功后删除，避免设备一直不上线。
bind_pending_token() {
    [ -f "${PENDING_TOKEN}" ] || return 0
    if is_configured; then
        rm -f "${PENDING_TOKEN}"
        return 0
    fi
    _tok=$(cat "${PENDING_TOKEN}" 2>/dev/null)
    [ -n "${_tok}" ] || return 0
    mkdir -p "${VAR_DIR}/logs" 2>/dev/null
    if [ -d "${VAR_DIR}/logs" ]; then
        "${BIN}" --workdir "${VAR_DIR}" authtoken "${_tok}" \
            >>"${VAR_DIR}/logs/authtoken.log" 2>&1
    else
        "${BIN}" --workdir "${VAR_DIR}" authtoken "${_tok}" >/dev/null 2>&1
    fi
    if is_configured; then
        rm -f "${PENDING_TOKEN}"
    fi
    return 0
}

# 未绑定时在面板日志里明确提示，避免“服务运行中但设备不上线”无从排查
warn_if_unconfigured() {
    is_configured && return 0
    printf '%s 警告：客户端尚未绑定 ZeroNews Token，云端不会上线。\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" >>"${LOGFILE}"
    printf '%s 绑定方式：echo "<你的Token>" > %s && chmod 600 %s，然后重启套件（启动时自动认证）。\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "${PENDING_TOKEN}" "${PENDING_TOKEN}" >>"${LOGFILE}"
}

# 桌面面板数据生成进程：把状态/日志落成静态文件供 DSM web 服务读取
start_ui_publisher() {
    [ -x "${PKG_SCRIPTS}/ui-publish.sh" ] || return 0

    if [ -f "${UIPIDFILE}" ]; then
        _upid=$(cat "${UIPIDFILE}" 2>/dev/null)
        if [ -n "${_upid}" ] && kill -0 "${_upid}" 2>/dev/null; then
            "${PKG_SCRIPTS}/ui-publish.sh" >/dev/null 2>&1
            return 0
        fi
    fi

    "${PKG_SCRIPTS}/ui-publish.sh" >/dev/null 2>&1
    nohup "${PKG_SCRIPTS}/ui-publish.sh" daemon >/dev/null 2>&1 &
    echo $! > "${UIPIDFILE}"
    return 0
}

stop_ui_publisher() {
    if [ -f "${UIPIDFILE}" ]; then
        _upid=$(cat "${UIPIDFILE}" 2>/dev/null)
        if [ -n "${_upid}" ]; then
            kill "${_upid}" 2>/dev/null
            _i=0
            while [ "${_i}" -lt 5 ]; do
                kill -0 "${_upid}" 2>/dev/null || break
                sleep 1
                _i=$((_i + 1))
            done
            kill -9 "${_upid}" 2>/dev/null
        fi
        rm -f "${UIPIDFILE}"
    fi
    # 停止后再生成一次，让面板显示「已停止」
    [ -x "${PKG_SCRIPTS}/ui-publish.sh" ] && "${PKG_SCRIPTS}/ui-publish.sh" >/dev/null 2>&1
    return 0
}

start_service() {
    if is_running; then
        start_ui_publisher
        return 0
    fi
    mkdir -p "${VAR_DIR}/logs"
    bind_pending_token
    warn_if_unconfigured
    cd "${PKG_DIR}" || return 1
    HOME="${VAR_DIR}" nohup "${BIN}" --workdir "${VAR_DIR}" start >>"${LOGFILE}" 2>&1 &
    echo $! > "${PIDFILE}"
    sleep 2
    if is_running; then
        start_ui_publisher
        return 0
    fi
    return 1
}

stop_service() {
    _pid=""
    if [ -f "${PIDFILE}" ]; then
        _pid=$(cat "${PIDFILE}" 2>/dev/null)
    fi

    # 优先优雅退出
    "${BIN}" --workdir "${VAR_DIR}" shutdown >/dev/null 2>&1

    if [ -n "${_pid}" ]; then
        _i=0
        while [ "${_i}" -lt 10 ]; do
            kill -0 "${_pid}" 2>/dev/null || break
            sleep 1
            _i=$((_i + 1))
        done
        if kill -0 "${_pid}" 2>/dev/null; then
            kill "${_pid}" 2>/dev/null
            sleep 2
        fi
        if kill -0 "${_pid}" 2>/dev/null; then
            kill -9 "${_pid}" 2>/dev/null
        fi
    fi

    rm -f "${PIDFILE}"
    stop_ui_publisher
    return 0
}

case "$1" in
    start)
        start_service
        exit $?
        ;;
    stop)
        stop_service
        exit $?
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    prestart|prestop)
        exit 0
        ;;
    *)
        exit 0
        ;;
esac